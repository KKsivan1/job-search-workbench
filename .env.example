NEXT_PUBLIC_CLOUD=1
NEXT_PUBLIC_CB_ENV=your-cloudbase-env-id
NEXT_PUBLIC_CB_REGION=ap-shanghai
# Only CloudBase's publishable Web access key belongs here.
# Never use a TencentCloud SecretKey or an admin token.
NEXT_PUBLIC_CB_ACCESS_KEY=

# SERVER ONLY: never prefix these with NEXT_PUBLIC_. Local defaults use .env.deepseek.local.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
